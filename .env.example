# BhoomiSetu Platform Docker Environment Configuration Template

# PostgreSQL Database Credentials
POSTGRES_DB=bhoomisetu_db
POSTGRES_USER=bhoomisetu_user
POSTGRES_PASSWORD=change-me-postgres-pass

# JWT Authentication Secret Key (MUST be set in production!)
JWT_SECRET_KEY=change-me-jwt-secret-key-32-chars

# Storage Backend Engine Configuration (minio or local)
STORAGE_TYPE=minio
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-pass
MINIO_BUCKET=bhoomisetu-documents
